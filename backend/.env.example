# VotoControl Moquegua 2026 — Backend
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://votocontrol:votocontrol@localhost:5432/votocontrol
REDIS_URL=redis://localhost:6379

# openssl rand -base64 64
JWT_SECRET=cambia-esto-por-un-secreto-de-64-bytes-en-base64
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-de-64-bytes-en-base64

# openssl rand -base64 32 (cifrado AES-256-GCM de la API Key de Gemini)
GEMINI_ENCRYPT_KEY=cambia-esto-por-32-bytes-en-base64
GEMINI_MODEL=gemini-1.5-flash

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Solo para seed inicial
SEED_SUPERADMIN_PASS=VotoControl2026!
SEED_DEMO=true
